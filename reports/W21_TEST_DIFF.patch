+
+    /// @notice Runs the full Transfer-mode round trip (Ethereum -> Base -> Ethereum) with
+    ///         pools sized 10x/5x of the moved value, and optionally a +~10% price move.
+    /// @param withPriceMove Mock the BackGeoOracle on both forks to appreciate the moved
+    ///        token ~+10% vs the base token while the position sits on the destination.
+    function _pocRoundTrip(bool withPriceMove) internal returns (RoundTripObs memory o) {
+        address srcPool = ethereum.pool;
+        address dstPool = base.pool;
+        console2.log("[poc] price move enabled:", withPriceMove);
+
+        // --- build source pool: TV ~ 10x position value, uv = 1.0 ------------------
+        vm.selectFork(mainnetForkId);
+        {
+            int256 perEth = IEOracle(srcPool).convertTokenAmount(Constants.ETH_WETH, int256(1e18), Constants.ETH_USDC);

+                } catch (bytes memory err) {
+                    o.dstAboveMaxReverted = true;
+                    o.dstAboveMaxErr = bytes4(err);
+                }
+                vm.revertToState(snap);
+            }
+            // the bound itself must burn
+            vm.prank(user);
+            try ISmartPoolActions(dstPool).burn(maxBurn, 0) returns (uint256 netRev) {

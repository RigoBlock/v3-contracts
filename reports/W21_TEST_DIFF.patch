+            o.srcTsPre = t.totalSupply;
+            o.srcUvPre = t.unitaryValue;
+            o.srcClaimPre = (uint256(t.totalSupply) * t.unitaryValue) / 1e6;
+            console2.log("[poc] src built. WETH position value (USDC):", o.vSend / 1e6);
+            console2.log("[poc] src TS pre (USDC):", o.srcTsPre / 1e6);
+            console2.log("[poc] src uv pre:", o.srcUvPre);
+        }
+
+        // --- build destination pool: TV ~ 5x position value ------------------------
+        vm.selectFork(baseForkId);
+        {
+            // size by the DESTINATION chain's own oracle valuation of the same position so
+            // the moved fraction k = v / TS ~= 0.2 exactly as in the reference sim
+            uint256 vSendDst = uint256(
+                IEOracle(dstPool).convertTokenAmount(Constants.BASE_WETH, int256(o.wSend), Constants.BASE_USDC)
+            );
+            console2.log("[poc] moved position value on dst oracle (USDC):", vSendDst / 1e6);
+            uint256 usdcBalD = IERC20(Constants.BASE_USDC).balanceOf(dstPool);
+            uint256 target = 5 * vSendDst;
+            uint256 extra = target > usdcBalD ? target - usdcBalD : 0;
+            uint256 mintAmt = (extra * 10_000) / 9_990 + 1;
+            deal(Constants.BASE_USDC, user, mintAmt + 1e12);
+            vm.startPrank(user);
+            IERC20(Constants.BASE_USDC).approve(dstPool, type(uint256).max);

+            ISmartPoolActions(dstPool).updateUnitaryValue();
+            ISmartPoolState.PoolTokens memory td = ISmartPoolState(dstPool).getPoolTokens();
+            o.dstTsFinal = td.totalSupply;
+            o.dstUvFinal = td.unitaryValue;
+            o.dstBalFinal = IERC20(Constants.BASE_USDC).balanceOf(dstPool);
+            o.dstClaimFinal = (uint256(td.totalSupply) * td.unitaryValue) / 1e6;
+            o.dstVsFinal = int256(uint256(vm.load(dstPool, virtualSupplySlot)));

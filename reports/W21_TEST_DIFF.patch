+
+            uint256 absVs = uint256(-o.dstVsFinal);
+            uint256 tail = absVs == 0 ? 0 : (absVs * 20 + 18) / 19; // ceil(|VS| * 20 / 19)
+            o.dstTailBound = tail;
+            uint256 maxBurn = o.dstTsFinal - tail;

+            if (probe > 0) {
+                vm.prank(user);
+                try ISmartPoolActions(dstPool).burn(probe, 0) returns (uint256) {
+                    o.dstTailBurnReverted = false;
+                } catch (bytes memory err) {
+                    o.dstTailBurnReverted = true;
+                    o.dstTailBurnErr = bytes4(err);

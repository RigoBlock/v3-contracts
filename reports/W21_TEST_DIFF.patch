+            console2.log("[poc] dst uv after move:", o.dstUvAfterMove);
+            console2.log("[poc] dst TV after move (USDC):", o.dstTvAfterMove / 1e6);
+        }
+
+        // --- leg 3: destination outbound (return whole position) -------------------
+        uint256 wBack = IERC20(Constants.BASE_WETH).balanceOf(dstPool);
+        {
+            IAIntents.AcrossParams memory params = IAIntents.AcrossParams({
+                depositor: poolOwner,
+                recipient: srcPool,
+                inputToken: Constants.BASE_WETH,
+                outputToken: Constants.ETH_WETH,
+                inputAmount: wBack,
+                outputAmount: wBack,
+                destinationChainId: Constants.ETHEREUM_CHAIN_ID,
+                exclusiveRelayer: address(0),
+                quoteTimestamp: uint32(block.timestamp),
+                fillDeadline: uint32(block.timestamp + 1 hours),
+                exclusivityDeadline: 0,
+                message: abi.encode(

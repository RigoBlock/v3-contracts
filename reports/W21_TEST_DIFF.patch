+    /// @notice PoC: Transfer-mode round trip WITH a +10% price move. The destination ends
+    ///         with a negative VS residual (phantom claim + unburnable tail) and the source
+    ///         keeps a stranded positive VS residual at uv = 1.0.
+    function test_PoC_RoundTrip_Transfer_PriceMove_Residuals() public {
+        console2.log("\n===== PoC: Transfer-mode round trip with +10% price move =====");
+        RoundTripObs memory o = _pocRoundTrip(true);
+
+        vm.selectFork(baseForkId);
+        console2.log("\n--- destination (Base) after round trip ---");
+        console2.log("dst VS final (USDC):", o.dstVsFinal / 1e6);
+        console2.log("dst TS final (USDC):", o.dstTsFinal / 1e6);
+        console2.log("dst uv final:", o.dstUvFinal);
+        console2.log("dst USDC balance final (USDC):", o.dstBalFinal / 1e6);
+        console2.log("dst total claim (USDC):", o.dstClaimFinal / 1e6);
+        console2.log("dst phantom NAV (claim - balance, USDC):", (o.dstClaimFinal - o.dstBalFinal) / 1e6);
+        console2.log("dst unburnable tail bound (shares):", o.dstTailBound);
+        console2.log("dst max burnable (shares):", o.dstTsFinal - o.dstTailBound);
+        console2.log("dst max burn payout net (USDC):", o.dstMaxBurnNet / 1e6);
+        console2.log("dst above-max revert selector:");
+        console2.logBytes4(o.dstAboveMaxErr);
+        console2.log("dst tail revert selector:");
+        console2.logBytes4(o.dstTailBurnErr);
+        {
+            uint256 absVs = uint256(-o.dstVsFinal);
+            console2.log("dst |VS| / TS (bps):", (absVs * 10000) / o.dstTsFinal);
+        }
+        console2.log("--- raw values (6-dec base units) ---");
+        console2.log("dst VS final raw:", o.dstVsFinal);
+        console2.log("dst VS after in raw:", o.dstVsAfterIn);
+        console2.log("dst TS raw:", o.dstTsFinal);
+        console2.log("dst uv after in raw:", o.dstUvAfterIn);
+        console2.log("dst uv after move raw:", o.dstUvAfterMove);
+        console2.log("dst uv final raw:", o.dstUvFinal);
+        console2.log("dst claim raw:", o.dstClaimFinal);
+        console2.log("dst balance raw:", o.dstBalFinal);
+        console2.log("dst maxBurn net raw:", o.dstMaxBurnNet);
+        console2.log("src VS final raw:", o.srcVsFinal);
+        console2.log("src TS raw:", o.srcTsFinal);
+        console2.log("src claim raw:", o.srcClaimFinal);
+        console2.log("src claim pre-out raw:", o.srcClaimPre);
+        console2.log("wSend raw (WETH wei):", o.wSend);
+        console2.log("vSend raw (USDC units):", o.vSend);
+
+        assertEq(o.srcVsAfterOut, -int256(o.vSend), "leg1 -VS must equal the departure value");
+        assertLt(o.dstVsFinal, 0, "dst VS must end negative");
+        assertGt(o.dstClaimFinal, o.dstBalFinal, "dst claim must exceed physical balance (phantom)");
+        assertEq(o.dstUserBalPreBurn, o.dstTsFinal, "user must hold the whole supply");
+        assertTrue(o.dstAboveMaxReverted, "burn(maxBurnable+1) must revert");
+        assertEq(o.dstAboveMaxErr, NavImpactLib.EffectiveSupplyTooLow.selector, "different revert above max");
+        assertTrue(o.dstMaxBurnOk, "burn(maxBurnable) must succeed");
+        assertTrue(o.dstTailBurnReverted, "tail burn must revert");
+        assertEq(o.dstTailBurnErr, NavImpactLib.EffectiveSupplyTooLow.selector, "different revert on tail");
+        {
+            uint256 absVs = uint256(-o.dstVsFinal);
+            assertGt(absVs, o.dstTsFinal / 100, "dst residual must exceed 1% of TS");
+            assertLt(absVs, o.dstTsFinal / 40, "dst residual must stay under 2.5% of TS");
+        }
+
+        vm.selectFork(mainnetForkId);
+        console2.log("\n--- source (Ethereum) after round trip ---");
+        console2.log("src VS final (USDC):", o.srcVsFinal / 1e6);
+        console2.log("src uv final:", o.srcUvFinal);
+        console2.log("src TS final (USDC):", o.srcTsFinal / 1e6);
+        console2.log("src claim final (USDC):", o.srcClaimFinal / 1e6);
+        console2.log("src claim pre-out (USDC):", o.srcClaimPre / 1e6);
+        console2.log("src burn gross (USDC):", o.srcBurnGross / 1e6);
+        console2.log("src burn net (USDC):", o.srcBurnNet / 1e6);
+
+        assertGt(o.srcVsFinal, 0, "src VS must end positive (stranded)");
+        assertApproxEqRel(uint256(o.srcVsFinal), o.vSend / 10, 0.05e18, "stranded value not ~10% of moved value");
+        assertApproxEqAbs(o.srcUvFinal, 1e6, 1, "src uv must stay at 1.0");
+        assertApproxEqAbs(o.srcClaimFinal, o.srcClaimPre, 2, "src local claim must be unchanged");
+        assertTrue(o.srcBurnOk, "src burn must succeed");
+        assertApproxEqAbs(o.srcBurnGross, o.srcBurnShares, 2, "burn payout must be at par (uv=1.0)");
+        assertApproxEqAbs(o.srcBurnNet, (o.srcBurnShares * 999) / 1000, 2, "burn net must be par minus spread");
+    }
+
+    /// @notice Control: the same round trip WITHOUT the price move leaves no VS residual
+    ///         on either chain, and the full supply remains burnable.
+    function test_PoC_RoundTrip_NoPriceMove_Control() public {
+        console2.log("\n===== CONTROL: same round trip, no price move =====");
+        RoundTripObs memory o = _pocRoundTrip(false);
+
+        vm.selectFork(baseForkId);
+        console2.log("dst VS final:", o.dstVsFinal);
+        console2.log("dst tail bound:", o.dstTailBound);
+        console2.log("dst full-supply burn ok:", o.dstMaxBurnOk);
+        console2.log("dst VS raw:", o.dstVsFinal);
+        console2.log("dst TS raw:", o.dstTsFinal);
+        console2.log("dst balance raw:", o.dstBalFinal);
+        console2.log("dst maxBurn net raw:", o.dstMaxBurnNet);
+        assertEq(o.dstVsFinal, 0, "control: dst VS residual must be zero");
+        assertEq(o.dstTailBound, 0, "control: no unburnable tail");
+        assertTrue(o.dstMaxBurnOk, "control: full supply must burn");
+
+        vm.selectFork(mainnetForkId);
+        console2.log("src VS final:", o.srcVsFinal);
+        console2.log("src uv final:", o.srcUvFinal);
+        assertEq(o.srcVsFinal, 0, "control: src VS residual must be zero");
+        assertTrue(o.srcBurnOk, "control: src burn must succeed");
+        console2.log("control completed - only rounding-level residuals");
+    }
+
+    /*//////////////////////////////////////////////////////////////////////////
+        PoC HELPERS — oracle observe() mocking (technique from
+        AIntentsPerformanceAttributionAnalysis.t.sol test_MockObserveForPriceChange)
+    //////////////////////////////////////////////////////////////////////////*/
+
+    /// @dev Mirrors EOracle price math for a tick: price = sqrtPriceX96^2 / 2^96, applied to amount.
+    function _pocSimConvert(uint256 amount, int24 tick) internal pure returns (uint256) {
+        uint160 sqrtPriceX96 = TickMath.getSqrtPriceAtTick(tick);
+        uint256 priceX96 = FullMath.mulDiv(uint256(sqrtPriceX96), uint256(sqrtPriceX96), 2 ** 96);
+        return FullMath.mulDiv(amount, priceX96, 2 ** 96);
+    }
+
+    /// @dev Same secondsAgos derivation as EOracle._getSecondsAgos (8 s on mainnet, 1 s elsewhere).
+    function _pocSecondsAgos(uint16 cardinality) internal view returns (uint32[] memory secondsAgos) {
+        require(cardinality > 1, "oracle pool without observations");
+        uint256 blockTime = block.chainid == Constants.ETHEREUM_CHAIN_ID ? 8 : 1;
+        uint256 maxSecondsAgos = uint256(cardinality - 1) * blockTime;
+        secondsAgos = new uint32[](2);
+        secondsAgos[0] = maxSecondsAgos > 300 ? 300 : uint32(maxSecondsAgos);
+        secondsAgos[1] = 0;
+    }
+
+    /// @dev Mocks BackGeoOracle.observe() for the (native, baseToken) pool so the wrapped
+    ///      native token gains ~+10% vs the base token. Verifies the mock landed by comparing
+    ///      convertTokenAmount against the same sqrt-price math EOracle uses.
+    function _pocApplyPriceMove(
+        address samplePool,
+        address oracleHook,
+        address wethToken,
+        address baseToken
+    ) internal returns (uint256 convBefore, uint256 convAfter) {
+        (bytes memory callData, bytes memory returnData) = _pocPriceMoveMock(oracleHook, baseToken);
+        convBefore = uint256(IEOracle(samplePool).convertTokenAmount(wethToken, int256(1e18), baseToken));
+        vm.mockCall(oracleHook, callData, returnData);
+        convAfter = uint256(IEOracle(samplePool).convertTokenAmount(wethToken, int256(1e18), baseToken));
+        require(convAfter != convBefore, "observe() mock did not land");
+        require(convAfter >= (convBefore * 105) / 100 && convAfter <= (convBefore * 115) / 100, "move magnitude off");
+        console2.log("[poc] price move convBefore:", convBefore, "convAfter:", convAfter);
+    }
+
+    /// @dev Builds the (calldata, returndata) pair for a ~+10% WETH-vs-base observe() mock.
+    function _pocPriceMoveMock(
+        address oracleHook,
+        address baseToken
+    ) internal view returns (bytes memory callData, bytes memory returnData) {
+        IPoCBackGeoOracle.PoolKey memory key = IPoCBackGeoOracle.PoolKey({
+            currency0: Currency.wrap(address(0)),
+            currency1: Currency.wrap(baseToken),
+            fee: 0,
+            tickSpacing: TickMath.MAX_TICK_SPACING,
+            hooks: IHooks(oracleHook)
+        });
+        IPoCBackGeoOracle.ObservationState memory st = IPoCBackGeoOracle(oracleHook).getState(key);
+        uint32[] memory secondsAgos = _pocSecondsAgos(st.cardinality);
+        (int56[] memory tc, uint160[] memory liq) = IPoCBackGeoOracle(oracleHook).observe(key, secondsAgos);
+        int24 twap = int24((tc[1] - tc[0]) / int56(int32(secondsAgos[0])));
+
+        // 953 ticks = 1.0001^953 ~= +10.0% on the conversion price (either direction).
+        int24 tUp = twap + 953;
+        int24 tDn = twap - 953;
+        int24 chosen = _pocSimConvert(1e18, tUp) >= _pocSimConvert(1e18, tDn) ? tUp : tDn;
+
+        // observe() must return cumulatives whose implied twap is `chosen`:
+        // twap = (tc[1] - tc[0]) / secondsAgos[0]  =>  mocked tc[0] = tc[1] - chosen * secondsAgos[0]
+        int56[] memory mocked = new int56[](2);
+        mocked[0] = tc[1] - int56(chosen) * int56(uint56(secondsAgos[0]));
+        mocked[1] = tc[1];
+
+        callData = abi.encodeWithSelector(IPoCBackGeoOracle.observe.selector, key, secondsAgos);
+        returnData = abi.encode(mocked, liq);
+    }
 }

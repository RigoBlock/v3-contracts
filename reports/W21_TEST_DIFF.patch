+        uint256 srcClaimPre;
+        uint256 dstTsPre;
+        uint256 dstUvPre;
+        int256 srcVsAfterOut;
+        int256 dstVsAfterIn;
+        uint256 dstTsAfterIn;
+        uint256 dstUvAfterIn;
+        uint256 dstUvAfterMove;

+        }
+        {
+            ISmartPoolActions(dstPool).updateUnitaryValue();
+            ISmartPoolState.PoolTokens memory td = ISmartPoolState(dstPool).getPoolTokens();
+            o.dstUvAfterMove = td.unitaryValue;
+            o.dstTvAfterMove =
+                (uint256(td.totalSupply) + uint256(int256(uint256(vm.load(dstPool, virtualSupplySlot))))) *
+                td.unitaryValue /

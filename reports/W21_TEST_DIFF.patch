+            IAIntents(dstPool).depositV3(params);
+            console2.log("[poc] leg3 dst return done");
+        }
+
+        // --- leg 4: source inbound via the real Across MulticallHandler ------------
+        vm.selectFork(mainnetForkId);
+        if (withPriceMove) {
+            _pocApplyPriceMove(srcPool, Constants.ORACLE, Constants.ETH_WETH, Constants.ETH_USDC);
+        }
+        {
+            SourceMessageParams memory sm = SourceMessageParams({
+                opType: OpType.Transfer,
+                navTolerance: TOLERANCE_BPS,
+                shouldUnwrapOnDestination: false,
+                sourceNativeAmount: 0

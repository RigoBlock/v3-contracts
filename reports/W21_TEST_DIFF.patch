+            ISmartPoolActions(srcPool).mintWithToken(poolOwner, x, 0, Constants.ETH_WETH);
+            vm.stopPrank();
+        }
+        {
+            o.wSend = IERC20(Constants.ETH_WETH).balanceOf(srcPool);
+            o.vSend = uint256(
+                IEOracle(srcPool).convertTokenAmount(Constants.ETH_WETH, int256(o.wSend), Constants.ETH_USDC)
+            );
+            uint256 usdcBal = IERC20(Constants.ETH_USDC).balanceOf(srcPool);
+            uint256 target = 10 * o.vSend;
